                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"Key discussion points…\\n\\n- Career roadmap\\n- Resume feedback\\n- Next steps\",\n  \"type\": \"note\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/shared-notes",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "shared-notes"]
                        },
                        "description": "Creates or updates mentor's shared note (`is_shared=true`). Same as web Save Shared Notes."
                    },
                    "response": []
                },
                {
                    "name": "Save shared notes (PUT upsert)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"Updated shared summary for mentee…\",\n  \"type\": \"note\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/shared-notes",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "shared-notes"]
                        },
                        "description": "Same upsert as POST."
                    },
                    "response": []
                },
                {
                    "name": "Update shared note by id",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"Patched shared note content…\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/shared-notes/{{sharedNoteId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "shared-notes", "{{sharedNoteId}}"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Delete shared note",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/shared-notes/{{sharedNoteId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "shared-notes", "{{sharedNoteId}}"]
                        }
                    },
                    "response": []
                }
            ]
        },
