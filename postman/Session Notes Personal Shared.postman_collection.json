{
    "info": {
        "name": "Session Notes — Personal & Shared",
        "description": "Personal notes (private) and Shared notes (visible to mentor + mentee), matching the web session detail UI.\n\n**Variables**\n- `baseUrl` — e.g. `http://127.0.0.1:8000/api/v1` or `https://vedrix.online/api/v1`\n- `mentorToken` / `menteeToken` — Sanctum bearer tokens\n- `sessionId` — consultation session id both users own\n- `personalNoteId` / `sharedNoteId` — set after create/list\n\n**Personal** → `/sessions/{id}/notes` (`is_shared=false`)\n**Shared** → `/sessions/{id}/shared-notes` (`is_shared=true`)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://vedrix.online/api/v1"
        },
        {
            "key": "mentorToken",
            "value": ""
        },
        {
            "key": "menteeToken",
            "value": ""
        },
        {
            "key": "sessionId",
            "value": "2"
        },
        {
            "key": "personalNoteId",
            "value": "1"
        },
        {
            "key": "sharedNoteId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Mentor — Personal Notes",
            "description": "Private notes — only the mentor can see these (web: My Personal Notes).",
            "item": [
                {
                    "name": "List personal notes",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "try {",
                                    "  const json = pm.response.json();",
                                    "  if (json.my_note && json.my_note.id) {",
                                    "    pm.collectionVariables.set('personalNoteId', String(json.my_note.id));",
                                    "  } else if (json.notes && json.notes[0]) {",
                                    "    pm.collectionVariables.set('personalNoteId', String(json.notes[0].id));",
                                    "  }",
                                    "} catch (e) {}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/notes",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "notes"]
                        },
                        "description": "Returns only the current user's personal notes (`is_shared=false`). Includes `my_note`."
                    },
                    "response": []
                },
                {
                    "name": "Save personal note",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "try {",
                                    "  const json = pm.response.json();",
                                    "  if (json.note && json.note.id) {",
                                    "    pm.collectionVariables.set('personalNoteId', String(json.note.id));",
                                    "  }",
                                    "} catch (e) {}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"My private reminders from this session…\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/notes",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "notes"]
                        },
                        "description": "Creates or upserts personal note with `is_shared=false`."
                    },
                    "response": []
                },
                {
                    "name": "Update personal note",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"Updated private notes…\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/notes/{{personalNoteId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "notes", "{{personalNoteId}}"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Delete personal note",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/mentor/sessions/{{sessionId}}/notes/{{personalNoteId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["mentor", "sessions", "{{sessionId}}", "notes", "{{personalNoteId}}"]
                        }
                    },
                    "response": []
                }
            ]
        },
